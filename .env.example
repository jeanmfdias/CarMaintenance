# Frontend build args (consumed by Vite at build time).

# When the stack runs behind the bundled nginx proxy, the frontend talks to the
# backend through a relative path. Override only if you serve the API elsewhere.
VITE_API_BASE_URL=/api/v1

# In dev, Vite proxies /api and /uploads to http://localhost:3001 (the
# CarMaintenance Node + SQLite backend) — see vite.config.ts. In production the
# nginx config in infra/nginx.conf handles the same proxying.
