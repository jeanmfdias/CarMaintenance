# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/app.db

# Auth
# IMPORTANT: must be a strong unique value (>=32 chars) in production.
# Boot will refuse to start with the default below when NODE_ENV=production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
MAGIC_LINK_TTL_MIN=15

# Public URL used inside magic-link emails (frontend origin)
PUBLIC_APP_URL=http://localhost:5173

# CORS — comma-separated origins (use exact origins, avoid '*')
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOADS_DIR=./data/uploads

# Request hardening
# Trust proxy (X-Forwarded-For). Set when behind nginx/Cloudflare so
# req.ip + rate limiting work correctly. Accepts: true, false, an integer
# hop count, or a subnet. Defaults to false.
TRUST_PROXY=false
# Cap JSON body size (Express express.json `limit` option syntax).
BODY_LIMIT=100kb

# SMTP — leave blank in dev to print magic links to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CarMaintenance <no-reply@example.com>"

# Rate limiting
# Global /api/v1 limiter — looser than per-endpoint auth limits. Per IP.
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_API_WINDOW_MS=900000

# Backup
# Override the destination directory for `npm run db:backup`.
# BACKUP_DIR=./data/backups
